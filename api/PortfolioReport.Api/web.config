<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for the deployed /finance virtual application.

  IIS-level auth (Basic, Windows, Digest, URL authorization) is intentionally
  NOT touched: Winhost locks <security><authentication> and
  <security><authorization> at the applicationHost.config tier, so any
  override here produces a 500.19 "Lock violation". The browser's native
  username/password popup — Winhost's "Password Protected Directory"
  feature — has to be disabled in the Winhost control panel; there is no
  web.config workaround.

  (Earlier versions of this file claimed <modules> was also locked. In
  practice WebDAVModule can be removed at the app level — see <modules>
  below. Other modules may still be locked; test before adding more.)

  The <aspNetCore> element's processPath/arguments are placeholders that
  `dotnet publish` rewrites at build time (via the SDK's _WebConfigTransform
  target). The deployed web.config will have the real values.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <!--
          WebDAVModule intercepts DELETE, PUT, MKCOL, COPY, MOVE, LOCK, and
          UNLOCK before any handler runs — including the aspNetCore handler.
          Without this remove, DELETE returns 405 "Method Not Allowed" with
          Allow: GET, HEAD, OPTIONS, TRACE. dotnet publish overwrites the
          deployed web.config on every build, so this remove must live in
          source — IIS Manager edits on the server don't survive a redeploy.
        -->
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <!--
          Defense-in-depth: also drop the WebDAV handler entry, in case
          WebDAVModule ever re-registers. StaticFile is removed too — the
          ASP.NET Core pipeline's UseStaticFiles middleware serves wwwroot,
          so IIS's StaticFile handler is redundant and has historically
          caused 405s when it grabs the URL before aspNetCore does.
        -->
        <remove name="WebDAV" />
        <remove name="StaticFile" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
