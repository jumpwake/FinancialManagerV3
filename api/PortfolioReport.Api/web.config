<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for the deployed /finance virtual application.

  Only the ASP.NET Core handler is configured here. IIS-level auth (Basic,
  Windows, Digest, URL authorization) is intentionally NOT touched: Winhost
  locks <modules>, <security><authentication>, and <security><authorization>
  at the applicationHost.config tier, so any override here produces a
  500.19 "Lock violation". The browser's native username/password popup —
  Winhost's "Password Protected Directory" feature — has to be disabled in
  the Winhost control panel; there is no web.config workaround.

  The <aspNetCore> element's processPath/arguments are placeholders that
  `dotnet publish` rewrites at build time (via the SDK's _WebConfigTransform
  target). The deployed web.config will have the real values.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!--
          IIS's built-in handlers (WebDAV, StaticFile) are registered globally
          and will catch verbs like DELETE before aspNetCore does — returning
          405 with Allow: GET, HEAD, OPTIONS, TRACE. Remove them from this
          application's chain so every request goes to aspNetCore.

          ASP.NET Core's UseStaticFiles middleware already serves wwwroot,
          so dropping IIS's StaticFile here is safe.

          We cannot disable WebDAVModule itself because <modules> is locked
          at the Winhost level — but removing it from <handlers> is enough
          to keep it out of the request pipeline for this app.
        -->
        <remove name="WebDAV" />
        <remove name="StaticFile" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
