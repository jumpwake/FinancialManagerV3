{
  "name": "portfolio-analyzer-v3",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "analyze": "tsx src/index.ts",
    "analyze:luke": "tsx src/index.ts --user luke",
    "analyze:carly": "tsx src/index.ts --user carly",
    "report": "tsx scripts/report.ts",
    "report:luke": "tsx scripts/report.ts --user luke",
    "report:carly": "tsx scripts/report.ts --user carly",
    "publish": "tsx scripts/publish.ts",
    "publish:kevin": "tsx scripts/publish.ts --user kevin",
    "publish:luke": "tsx scripts/publish.ts --user luke",
    "publish:carly": "tsx scripts/publish.ts --user carly",
    "publish:kevin:dev": "tsx scripts/publish.ts --user kevin --dev",
    "publish:luke:dev": "tsx scripts/publish.ts --user luke --dev",
    "publish:carly:dev": "tsx scripts/publish.ts --user carly --dev",
    "build": "tsc && vite build src/report/app",
    "build:api": "powershell -ExecutionPolicy Bypass -File scripts/build-api.ps1",
    "serve": "powershell -ExecutionPolicy Bypass -File scripts/serve-api.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-winhost.ps1",
    "deploy:whatif": "powershell -ExecutionPolicy Bypass -File scripts/deploy-winhost.ps1 -WhatIf",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "chart.js": "^4.4.1",
    "dotenv": "^16.6.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
